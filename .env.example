# ================================================================
# ALPHAFORGE MULTI-AGENT QUANT ENGINE CONFIGURATION
# ================================================================

# System Settings
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/alphaforge.db

# SEC EDGAR Integration (FREE - REQUIRED FORMAT: SampleApp user@domain.com)
SEC_USER_AGENT=AlphaForgeTrader research@alphaforge.local

# Optional Alpaca Paper Broker Integration (Get free keys at https://app.alpaca.markets)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Optional LLM Intelligence (Free tier or Local Ollama)
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:latest

# Optional Webhook Alerts (Real-time notifications to your phone)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Risk Management & Paper Trading Rules
PAPER_INITIAL_CASH=100.0
MAX_POSITION_SIZE_PCT=0.10
DEFAULT_STOP_LOSS_PCT=0.05
DEFAULT_TAKE_PROFIT_PCT=0.15
MAX_DAILY_DRAWDOWN_PCT=0.04

# Polling Intervals (in seconds)
POLLING_INTERVAL_SEC_EDGAR=60
POLLING_INTERVAL_CONTRACTS=300
POLLING_INTERVAL_FINRA=3600
POLLING_INTERVAL_QUANT=600
